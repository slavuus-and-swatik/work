# Generate a cryptographically random secret for signing admin sessions.
AUTH_SECRET=
# Store base64(bcrypt-hash) of the 32-character admin password here, never the password itself.
ADMIN_PASSWORD_HASH_B64=
# Separate credentials for the internal platform operations console (/platform-admin).
PLATFORM_AUTH_SECRET=
PLATFORM_ADMIN_PASSWORD_HASH_B64=
# Enable only behind a trusted proxy that replaces this header on every request.
TRUST_PLATFORM_AUTH_HEADER=false
