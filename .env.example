# Generate a cryptographically random secret for signing admin sessions.
AUTH_SECRET=
# Store the bcrypt hash of the 32-character admin password here, never the password itself.
ADMIN_PASSWORD_HASH=
# PostgreSQL connection string used for products/site config, orders, bookings and uploaded images.
DATABASE_URL=
# Telegram bot notices for the administrator (token from BotFather and a chat ID that started the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Separate credentials for the internal platform operations console (/platform-admin).
PLATFORM_AUTH_SECRET=
PLATFORM_ADMIN_PASSWORD_HASH_B64=
# Enable only behind a trusted proxy that replaces this header on every request.
TRUST_PLATFORM_AUTH_HEADER=false
